{
  "name": "libris",
  "version": "1.0.0",
  "description": "Libris - Modern Library Management System",
  "scripts": {
    "dev": "concurrently --names \"BACKEND,FRONTEND\" --prefix-colors \"blue,green\" \"npm run backend\" \"npm run frontend\"",
    "backend": "cd \"Online Library Management System/library\" && python manage.py runserver",
    "frontend": "cd react-frontend-olms && npm start",
    "install-all": "cd react-frontend-olms && npm install"
  },
  "keywords": [
    "library",
    "management",
    "django",
    "react"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

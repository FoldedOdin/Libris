# API Configuration
REACT_APP_API_URL=http://localhost:8000/api
REACT_APP_ENVIRONMENT=development

# Build optimization settings (production only)
GENERATE_SOURCEMAP=true
INLINE_RUNTIME_CHUNK=true

# Performance settings
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_ERROR_REPORTING=false

# Security settings
REACT_APP_ENABLE_HTTPS=false
REACT_APP_SECURE_COOKIES=false

# Cache settings
REACT_APP_CACHE_VERSION=1.0.0-dev

# Environment
NODE_ENV=development

# Optional: Other configuration variables
# REACT_APP_APP_NAME=Online Library Management System
# REACT_APP_VERSION=1.0.0